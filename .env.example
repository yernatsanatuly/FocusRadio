# PostgreSQL connection string used by SQLAlchemy & Alembic
DATABASE_URL=postgresql+psycopg://focusradio:focusradio@localhost:5433/focusradio

# Separate database for automated tests (pytest / unittest)
TEST_DATABASE_URL=postgresql+psycopg://focusradio:focusradio@localhost:5433/focusradio_test

# Docker Compose PostgreSQL defaults
POSTGRES_USER=focusradio
POSTGRES_PASSWORD=focusradio
POSTGRES_DB=focusradio
POSTGRES_PORT=5433

# Application settings
FOCUSRADIO_SEED=1
FOCUSRADIO_SECONDS_PER_MINUTE=60
SQL_ECHO=false

# JWT Authentication settings (override JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=focusradio-dev-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
